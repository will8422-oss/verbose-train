# Kindle API auth - get from read.amazon.com browser cookies
# See: https://github.com/Xetera/kindle-api#cookies
KINDLE_COOKIES="ubid-main=...; at-main=...; x-main=...; session-id=..."

# Device token from read.amazon.com network tab
# Look for getDeviceToken request: serialNumber=(token)&deviceType=(token)
KINDLE_DEVICE_TOKEN=""

# TLS client server - host your own via https://github.com/bogdanfinn/tls-client-api
KINDLE_TLS_SERVER_URL="https://your-tls-server.example.com"
KINDLE_TLS_SERVER_API_KEY=""
